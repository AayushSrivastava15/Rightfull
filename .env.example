# ==============================================================================
# RIGHTFUL – MONOREPO ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local orchestration or reference the individual
# service templates in frontend/.env.example and backend/.env.example.
# NEVER commit real secret credentials or production values to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION RUNTIME & ENVIRONMENT
# ------------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8080
FRONTEND_PORT=5173
APP_PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# SUPABASE AUTH & API CONFIGURATION
# ------------------------------------------------------------------------------
# Project URL obtained from Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co

# Public/Anon key safe for client-side inclusion (frontend)
SUPABASE_ANON_KEY=eyJhYmNkZWZ...your-supabase-anon-key

# Service role secret (Server-side ONLY - never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJhYmNkZWZ...your-supabase-service-role-key

# Supabase JWKS URL for Spring Security JWT verification
# Default pattern: ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWT_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1

# ------------------------------------------------------------------------------
# POSTGRESQL DATABASE (SUPABASE POSTGRES)
# ------------------------------------------------------------------------------
# Supabase connection URI or direct/pooler host
DATABASE_HOST=aws-0-us-east-1.pooler.supabase.com
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=postgres.your-project-ref
DATABASE_PASSWORD=your-secure-database-password
DATABASE_URL=jdbc:postgresql://${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}?sslmode=require

# ------------------------------------------------------------------------------
# CRYPTOGRAPHIC KEYS & SECRETS
# ------------------------------------------------------------------------------
# High-entropy secret for HMAC-SHA-256 license key hashing (Min 256-bit / 32 bytes)
# Generate with: openssl rand -hex 32
LICENSE_HMAC_SECRET=generate_a_random_32_byte_hex_secret_here

# Master encryption key for product Ed25519 private keys at rest (AES-256-GCM)
# Generate with: openssl rand -base64 32
ED25519_MASTER_ENCRYPTION_KEY=generate_a_random_32_byte_base64_secret_here

# ------------------------------------------------------------------------------
# LICENSING POLICY DEFAULTS
# ------------------------------------------------------------------------------
DEFAULT_OFFLINE_GRACE_PERIOD_HOURS=7
DEFAULT_VALIDATION_INTERVAL_MINUTES=5

