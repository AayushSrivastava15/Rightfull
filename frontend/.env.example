# ==============================================================================
# RIGHTFUL FRONTEND – ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to frontend/.env.local for local development.
# Only variables prefixed with VITE_ are exposed to the client bundle.
# ==============================================================================

# Backend REST API Base URL
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Supabase Auth Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhYmNkZWZ...your-supabase-anon-key

# Application Metadata
VITE_APP_NAME="Rightful"
VITE_APP_DESCRIPTION="Production-Grade Software Licensing Platform"
