# ==============================================================================
# RIGHTFULL BACKEND – ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to backend/.env for local development or pass via environment.
# NEVER commit real credentials.
# ==============================================================================

# Active Spring Profile (e.g. local, test, staging, production)
SPRING_PROFILES_ACTIVE=local
PORT=8080

# Supabase PostgreSQL Configuration (Session Pooler)
# Format: jdbc:postgresql://aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=jdbc:postgresql://your-project-ref.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USER=postgres.your-project-ref
DATABASE_PASSWORD=your_secure_database_password
DATABASE_DRIVER=org.postgresql.Driver
FLYWAY_ENABLED=false

# Supabase Auth / JWT Validation
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1

# Security & Cryptography Configuration
# Secret for HMAC-SHA-256 license key hashing (Min 32 bytes)
LICENSE_HMAC_SECRET=generate_a_random_32_byte_hex_secret_here

# AES-256 master key for encrypting product Ed25519 private keys at rest
ED25519_MASTER_ENCRYPTION_KEY=generate_a_random_32_byte_base64_secret_here

# Licensing Engine Defaults
RIGHTFULL_LICENSING_DEFAULT_GRACE_PERIOD_HOURS=7
RIGHTFULL_LICENSING_DEFAULT_VALIDATION_INTERVAL_MINUTES=5

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
