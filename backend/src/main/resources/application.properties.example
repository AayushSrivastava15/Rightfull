# ==============================================================================
# RIGHTFULL SAAS LICENSING PLATFORM - APPLICATION PROPERTIES TEMPLATE
# ==============================================================================
# Copy this file to application.properties or application-local.properties.
# NEVER commit real database credentials.
# ==============================================================================

# Application Identity & Profile
spring.application.name=rightfull-backend
spring.profiles.active=local

# Local Supabase PostgreSQL DataSource (supply via environment variables or backend/.env)
spring.datasource.url=${DATABASE_URL}
spring.datasource.username=${DATABASE_USER}
spring.datasource.password=${DATABASE_PASSWORD}
spring.datasource.driver-class-name=org.postgresql.Driver

# HikariCP Connection Pool Settings
spring.datasource.hikari.maximum-pool-size=10
spring.datasource.hikari.minimum-idle=2
spring.datasource.hikari.connection-timeout=30000
spring.datasource.hikari.connection-test-query=SELECT 1

# JPA & Hibernate Settings
spring.jpa.hibernate.ddl-auto=none
spring.jpa.open-in-view=false
spring.jpa.show-sql=false

# Flyway Database Migration
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=0
spring.flyway.locations=classpath:db/migration

# Actuator Observability
management.endpoints.web.exposure.include=health,info,metrics
management.endpoint.health.show-details=always

# Server Port
server.port=8080

# Supabase Auth & Resource Server Properties
supabase.url=${SUPABASE_URL:https://your-project-ref.supabase.co}
supabase.jwt.jwks-url=${SUPABASE_JWT_JWKS_URL:https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json}
supabase.jwt.issuer=${SUPABASE_JWT_ISSUER:https://your-project-ref.supabase.co/auth/v1}
supabase.jwt.expected-audience=${SUPABASE_JWT_AUDIENCE:authenticated}


